# Shared
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Europe/Madrid
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://mordida:mordida_local_password@localhost:5432/mordida_tasty?schema=public

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_PATH=/seguimiento/{ORDER_NUMBER}?t={TRACKING_TOKEN}
STRIPE_CANCEL_PATH=/checkout?cancelled=1

# Mail (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mordida Tasty <no-reply@mordidatasty.es>"

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Seed
MORDIDA_SEED_ADMIN_EMAIL=admin@mordidatasty.es
MORDIDA_SEED_ADMIN_PASSWORD=
MORDIDA_SEED_KITCHEN_EMAIL=cocina@mordidatasty.es
MORDIDA_SEED_KITCHEN_PASSWORD=
