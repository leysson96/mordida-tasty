# Shared
NODE_ENV=production
PORT=4000
APP_TIMEZONE=Europe/Madrid
FRONTEND_URL=https://www.tudominio.es
API_PUBLIC_URL=https://api.tudominio.es
CORS_ORIGIN=https://www.tudominio.es,https://tudominio.es
NEXT_PUBLIC_API_URL=https://api.tudominio.es

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Auth
JWT_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax

# Stripe live
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_PATH=/seguimiento/{ORDER_NUMBER}?t={TRACKING_TOKEN}
STRIPE_CANCEL_PATH=/checkout?cancelled=1

# Mail (SMTP real)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM="Mordida Tasty <no-reply@tudominio.es>"

# Uploads
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=5242880

# First production seed
MORDIDA_SEED_ADMIN_EMAIL=admin@tudominio.es
MORDIDA_SEED_ADMIN_PASSWORD=replace-with-a-long-temporary-admin-password
MORDIDA_SEED_KITCHEN_EMAIL=cocina@tudominio.es
MORDIDA_SEED_KITCHEN_PASSWORD=replace-with-a-long-temporary-kitchen-password
